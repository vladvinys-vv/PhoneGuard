<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================== -->
    <!-- HARDWARE FEATURES -->
    <!-- ============================== -->
    <!-- Приложение работает и без этих модулей: разрешения запрашиваются по требованию.
         Без required="false" Play считает камеру/микрофон/GPS/телефонию обязательными
         и скрывает приложение от Wi-Fi-only планшетов и части ТВ-боксов. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- ============================== -->
    <!-- CORE PERMISSIONS -->
    <!-- ============================== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Android 14+ требует тип foreground-сервиса для VPN-фаервола -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ============================== -->
    <!-- SIM SWAP PERMISSIONS -->
    <!-- ============================== -->
    <!-- Needed to detect SIM state changes -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Needed to resolve address at moment of SIM change -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Needed for backup SMS notification -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- ============================== -->
    <!-- ANTI-THEFT PERMISSIONS -->
    <!-- ============================== -->
    <!-- SMS for commands and SIM change alerts -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Location tracking -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Camera for failed attempts -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Foreground service camera type (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Microphone for audio recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- External storage for saving photos/recording -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 13+ media permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Device Admin for protection against uninstall -->
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN" />
    <!-- System Alert Window for Overlay -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ============================== -->
    <!-- CALL BLOCKER PERMISSIONS -->
    <!-- ============================== -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!-- ============================== -->
    <!-- PRIVACY SCANNER PERMISSIONS -->
    <!-- ============================== -->
    <!--
      Сканер malware/шпионского ПО анализирует ВСЕ установленные приложения.
      Без QUERY_ALL_PACKAGES на Android 11+ PackageManager возвращает только
      «видимые» пакеты (около десятка), и проверка становится бессмысленной.
      Это разрешённый вариант использования для антивируса/безопасности в Play.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_CLIPBOARD_IN_BACKGROUND"
        android:maxSdkVersion="33" />

    <!-- ============================== -->
    <!-- FIREWALL / VPN PERMISSIONS -->
    <!-- ============================== -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />
    <uses-permission android:name="android.permission.MANAGE_NETWORK_POLICY"
        tools:ignore="ProtectedPermissions" />

    <!-- ============================== -->
    <!-- BATTERY OPTIMIZATION EXCLUSION -->
    <!-- ============================== -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Разблокировка сейфа через BiometricPrompt (без этого разрешения
         BiometricPrompt.authenticate() завершается ошибкой) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="27" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <permission
        android:name="com.phoneguard.permission.CALL_SCREENING"
        android:permissionGroup="android.permission-group.PHONE"
        android:protectionLevel="normal" />

    <application
        android:name=".PhoneGuardApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhoneGuard"
        android:networkSecurityConfig="@xml/network_security_config">

        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts" />

        <!-- Use HiltWorkerFactory instead of the default WorkManager initializer -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Main Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PhoneGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Device Admin Receiver -->
        <receiver
            android:name=".antitheft.DeviceAdminReceiverImpl"
            android:exported="true"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- SMS Command Receiver -->
        <receiver
            android:name=".antitheft.SmsCommandReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- SMS Spam Filter (blacklist / spam database) -->
        <receiver
            android:name=".callblocker.SmsSpamReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <!-- Ниже приоритета анти-воровских команд (999): сначала обрабатываются
                 команды владельца, затем — фильтрация спама. -->
            <intent-filter android:priority="998">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Call Blocker Service -->
        <service
            android:name=".callblocker.CallScreeningServiceImpl"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Stealth Camera Service for Anti-Theft -->
        <service
            android:name=".antitheft.StealthCameraService"
            android:foregroundServiceType="camera"
            android:exported="false" />

        <!-- Shoulder Surfer Detection Service -->
        <service
            android:name=".shouldersurfer.ShoulderSurferService"
            android:foregroundServiceType="camera"
            android:exported="false" />

        <!-- VPN Firewall Service -->
        <service
            android:name=".firewall.PhoneGuardVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn_firewall" />
        </service>

        <!-- SIM Swap Confirmation -->
        <activity
            android:name=".simswap.SimSwapConfirmationActivity"
            android:exported="true"
            android:theme="@style/Theme.PhoneGuard"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <!-- Intrusion Warning Activity -->
        <activity
            android:name=".ui.IntrusionWarningActivity"
            android:exported="false"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.PhoneGuard" />

        <!-- SIM Swap Receiver -->
        <!-- exported=false: системные broadcast'ы (SIM_STATE_CHANGED, BOOT_COMPLETED)
             защищённые, доставляются приёмнику и без экспорта, а сторонние приложения
             не смогут подделать событие подмены SIM. -->
        <receiver
            android:name=".simswap.SimSwapReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.SIM_STATE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- New Package Receiver -->
        <receiver
            android:name=".spywarecheck.PackageAddedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
        <!-- Открывает расшифрованный предпросмотр сейфа внешнему просмотрщику -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
