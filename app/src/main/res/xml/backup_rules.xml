<?xml version="1.0" encoding="utf-8"?>
<!--
    Правила для Android 11 и ниже. При `android:allowBackup="false"` они не
    используются, но оставлены как «fail-safe»: если флаг когда-нибудь снимут,
    резервная копия всё равно не должна содержать данные приложения.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
